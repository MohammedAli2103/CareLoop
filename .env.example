# CareLoop Supabase Environment Configuration
# Replace these placeholders with your actual Supabase project credentials.
# Found in: Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional: Supabase Anon Key (alternative naming)
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# DO NOT add SUPABASE_SERVICE_ROLE_KEY here or with a VITE_ prefix.
# Service-role keys must only reside in secure backend environments.
